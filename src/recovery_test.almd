// Small ordinary-reader regressions. The frozen full-file oracle is separate.
import self.`mod` as pkg
import self.grammar
import self.lexer
import self.table
import gramide.lang
import gramide.parser
import gramide.tree
import gramide.names
import gramide.incremental

fn point(source: Bytes, offset: Int) -> (Int, Int) = {
  var line = 1
  var base = 0
  var at = 0
  while at < offset {
    if bytes.get_or(source, at, -1) == 10 then { line = line + 1; base = at + 1 } else ()
    at = at + 1
  }
  (line, offset - base + 1)
}
fn node_bounds(n: tree.Node, toks: List[tree.Token], size: Int) -> Unit = {
  assert(n.start >= 0 and n.start <= n.end and n.end <= list.len(toks))
  let start = match list.get(toks, n.start) { some(t) => t.start, none => -1 }
  let end = if n.end > n.start then (match list.get(toks, n.end - 1) { some(t) => t.end, none => -1 }) else start
  assert(start >= 0 and start <= end and end <= size)
  for k in n.kids {
    assert(k.start >= n.start and k.end <= n.end)
    node_bounds(k, toks, size)
  }
}
fn coordinates(p: parser.Parsed, source: Bytes) -> Unit = {
  var previous = 0
  for t in p.toks {
    assert(previous <= t.start and t.start <= t.end and t.end <= bytes.len(source))
    assert_eq((t.line, t.col), point(source, t.start))
    previous = t.end
  }
  node_bounds(p.root, p.toks, bytes.len(source))
}
fn matches(n: tree.Node, p: parser.Parsed, kind: String, from: Int, to: Int) -> Int = {
  let start = match list.get(p.toks, n.start) { some(t) => t.start, none => -1 }
  let end = if n.end > n.start then (match list.get(p.toks, n.end - 1) { some(t) => t.end, none => -1 }) else start
  var found = if names.name_at(p.names, n.kind) == kind and start == from and end == to then 1 else 0
  for k in n.kids { found = found + matches(k, p, kind, from, to) }
  found
}
fn missing_close(text: String, gaps: List[Int], message: String, complete: List[(String, Int, Int)]) -> Result[Unit, String] = {
  let path = "missing-close.json"
  let source = bytes.from_string(text)
  let toks = lexer.scan(text, false) |> result.map_err((e) => e.message)!
  let c = table.compiled()
  let dynamic = parser.compile(grammar.rules())
  let language = lang.compile(pkg.definition())
  // Recovery returning a tree, even with zero ERROR nodes, is not acceptance.
  assert(result.is_err(parser.parse_with(c, source, toks)))
  assert(result.is_err(parser.parse_with(dynamic, source, toks)))
  assert(result.is_err(parser.verify(c, source, toks)))
  assert(result.is_err(lang.parse_lang(language, path, text)))
  assert(result.is_err(lang.verify_lang(language, path, text)))
  let read = lang.read_lang(language, path, text)!
  assert_eq(read.error, some(path + ":" + message))
  assert_eq(read.gaps, gaps)
  assert_eq(read.errors, 0)
  assert_eq(read.parsed.toks, toks)
  let direct = parser.parse_recovering(c, source, toks) |> result.map_err((f) => parser.format_failure(f))!
  let rules = parser.parse_recovering(dynamic, source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert(incremental.same(read.parsed, direct), "generic reader and direct recovery differ")
  assert(incremental.same(direct, rules), "committed table and rules differ in recovery")
  for parsed in [read.parsed, direct, rules] {
    coordinates(parsed, source)
    assert_eq(parser.error_nodes(parsed.root, parser.error_kind(c)), 0)
    for record in complete {
      assert(matches(parsed.root, parsed, record.0, record.1, record.2) == 1,
        "required complete node: " + record.0 + " " + int.to_string(record.1) + ":" + int.to_string(record.2))
    }
  }
  ok(())
}

test "missing array closer retains every complete object key pair and value" {
  let _ = missing_close("[{\"a\":1},{\"b\":2}", [0], "1:1: `[` is never closed", [
    ("object", 1, 8), ("string", 2, 5), ("pair", 2, 7), ("number", 6, 7),
    ("object", 9, 16), ("string", 10, 13), ("pair", 10, 15), ("number", 14, 15),
  ])!
}
test "missing object closer retains both complete members" {
  let _ = missing_close("{\"a\":1,\"b\":2", [0], "1:1: `{` is never closed", [
    ("string", 1, 4), ("pair", 1, 6), ("number", 5, 6),
    ("string", 7, 10), ("pair", 7, 12), ("number", 11, 12),
  ])!
}
test "missing outer closer retains empty containers without accepting the document" {
  let _ = missing_close("[{}", [0], "1:1: `[` is never closed", [("object", 1, 3)])!
  let _ = missing_close("[[]", [0], "1:1: `[` is never closed", [("array", 1, 3)])!
  let _ = missing_close("[", [0], "1:1: `[` is never closed", [])!
  let _ = missing_close("{", [0], "1:1: `{` is never closed", [])!
}
test "multiple missing outer closers retain the complete inner subtree" {
  let _ = missing_close("[{\"a\":[1,{\"b\":2}]", [0, 1], "1:1: `[` is never closed", [
    ("string", 2, 5), ("pair", 2, 17), ("array", 6, 17), ("number", 7, 8),
    ("object", 9, 16), ("string", 10, 13), ("pair", 10, 15), ("number", 14, 15),
  ])!
  let _ = missing_close("[{\"a\":[1,{\"b\":2}", [0, 1, 4], "1:1: `[` is never closed", [
    ("string", 2, 5), ("number", 7, 8), ("object", 9, 16),
    ("string", 10, 13), ("pair", 10, 15), ("number", 14, 15),
  ])!
}
test "missing closer recovery preserves UTF8 byte columns and CRLF positions" {
  let _ = missing_close("[\r\n {\"日本\":\"雪😀\"},\r\n {\"b\":2}\r\n", [0], "1:1: `[` is never closed", [
    ("object", 4, 24), ("string", 5, 13), ("pair", 5, 23), ("string", 14, 23),
    ("object", 28, 35), ("string", 29, 32), ("pair", 29, 34), ("number", 33, 34),
  ])!
  let _ = missing_close("\r\n [\"雪\"", [0], "2:2: `[` is never closed", [("string", 4, 9)])!
}
test "recovery grammar and committed table keep strict valid and invalid controls" {
  assert_eq(parser.compile(grammar.rules()), table.compiled())
  let language = lang.compile(pkg.definition())
  for text in ["null", "42", "[]", "{}", "[1,{},[],true,false,null]", "{\"a\":{\"b\":[2,3]}}", "\r\n{\"日本\":\"雪😀\"}\r\n"] {
    let parsed = lang.parse_lang(language, "valid.json", text)!
    let read = lang.read_lang(language, "valid.json", text)!
    let _ = lang.verify_lang(language, "valid.json", text)!
    assert_eq(read.error, none)
    assert_eq(read.gaps, [])
    assert_eq(read.errors, 0)
    assert(incremental.same(parsed, read.parsed))
    coordinates(parsed, bytes.from_string(text))
  }
  for text in ["[1,]", "[1 2]", "{\"a\":1,}", "{\"a\":}", "{}[]", "{\"a\":[1,2}", "[[1]", "[{\"a\":1]"] {
    assert(result.is_err(lang.parse_lang(language, "bad.json", text)))
    assert(result.is_err(lang.verify_lang(language, "bad.json", text)))
  }
}
test "unsupported root prefix preserves the generic reader filename" {
  match lang.read_lang(lang.compile(pkg.definition()), "prefix.json", "{[{\"a\":1},{\"b\":2}]") {
    err(message) => assert(string.starts_with(message, "prefix.json:")),
    ok(_) => assert(false, "this repair does not add root-prefix recovery"),
  }
}

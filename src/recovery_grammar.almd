// JSON syntax as original gramide rules; reference: RFC 8259 §§2–7.
import gramide.parser
import gramide.parser.{ tok, lit, r, seq, alt, rep, opt, wrap, field, grammar, recover, recover_all, recover_keeping, recover_all_keeping, ahead }

// Item boundaries let the shared incremental engine re-lex/re-read a member
// or array value instead of rescanning the document. In strict mode these
// operators still require exactly `item`; separators/trailing-comma rules stay.
// Recovery is bounded by the owning delimiter. Actual EOF may satisfy a
// completed member boundary during recovery, while the outer mandatory closer
// still rejects an incomplete strict document. Local windows must keep the
// unchanged head token and require the exact endpoint before temporary EOF.
// Only the second argument of existing recovery operators varies. Every
// successful strict body, separator owner and mandatory closer stays exact.
fn member_with_head(item: parser.Rule, close: String, head: parser.Rule) -> parser.Rule =
  recover_keeping(seq([item, ahead(alt([lit(","), lit(close), tok("eof")]))]), head)
fn members_with_head(item: parser.Rule, close: String, head: parser.Rule) -> parser.Rule =
  opt(seq([member_with_head(item, close, head), rep(seq([lit(","), member_with_head(item, close, head)]))]))
// First keep an intact pair if its following boundary failed. The fallback
// preserves standalone fragments; it never fabricates a pair with no colon
// or no value. All these heads execute in recovery mode, not strict mode.
fn pair_head() -> parser.Rule = alt([r("pair"), seq([tok("string"), opt(lit(":")), opt(r("value"))])])
// This helper requires and consumes one ACTUAL closer token. K_KEEP cannot
// satisfy repaired_here/implicit K_LIT closer rules; Ahead discards its node.
// The final Any consumes exactly that guarded token and emits no node.
fn actual_close(close: String) -> parser.Rule = seq([ahead(parser.keep(close)), parser.any()])
fn nonempty_members(item: parser.Rule, close: String, head: parser.Rule) -> parser.Rule =
  seq([member_with_head(item, close, head), rep(seq([lit(","), member_with_head(item, close, head)]))])
fn trailing_array() -> parser.Rule = wrap("array", seq([lit("["), nonempty_members(r("value"), "]", r("value")), lit(","), actual_close("]")]))
fn trailing_object() -> parser.Rule = wrap("object", seq([lit("{"), nonempty_members(r("pair"), "}", pair_head()), lit(","), actual_close("}")]))
// Canonical value/pair recursion never refers to either trailing-head alias.
// Thus this adds a root-only alternative, not recursive relaxed-value rules.
fn rules_for(trailing: Bool) -> parser.Grammar = {
  let head = if trailing then alt([r("value"), r("trailing_array_head"), r("trailing_object_head")]) else r("value")
  let base = [
    ("document", wrap("document", recover_all_keeping(seq([r("value"), ahead(tok("eof"))]), head))),
    ("value", alt([r("object"), r("array"), tok("string"), tok("number"), wrap("true", lit("true")), wrap("false", lit("false")), wrap("null", lit("null"))])),
    ("object", wrap("object", seq([lit("{"), members_with_head(r("pair"), "}", pair_head()), lit("}")]))),
    ("pair", wrap("pair", seq([field("name", tok("string")), lit(":"), field("value", r("value"))]))),
    ("array", wrap("array", seq([lit("["), members_with_head(r("value"), "]", r("value")), lit("]")]))),
  ]
  grammar("document", if trailing then base + [("trailing_array_head", trailing_array()), ("trailing_object_head", trailing_object())] else base)
}
fn rules() -> parser.Grammar = rules_for(true)
